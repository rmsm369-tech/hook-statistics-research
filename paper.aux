\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Relative error $R(t,n)$ and parity-of-$n$ split. Odd $t$ exhibits persistently higher relative error for $n < 30$.}}{6}{figure.caption.6}\protected@file@percent }
\newlabel{fig:relErr}{{5}{6}{Relative error $R(t,n)$ and parity-of-$n$ split. Odd $t$ exhibits persistently higher relative error for $n < 30$}{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Scaled error $e(t,n)\sqrt  {n}$ for $t=1,2,3$. The quantity is bounded and oscillatory, numerically verifying the theoretical $O(n^{-1/2})$ decay.}}{6}{figure.caption.7}\protected@file@percent }
\newlabel{fig:scaled}{{6}{6}{Scaled error $e(t,n)\sqrt {n}$ for $t=1,2,3$. The quantity is bounded and oscillatory, numerically verifying the theoretical $O(n^{-1/2})$ decay}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Log relative error. The downward linear trend suggests polynomial decay, not exponential.}}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:decay}{{7}{6}{Log relative error. The downward linear trend suggests polynomial decay, not exponential}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Left: signed error $e(t,n)$. Right: Raw FFT of $e(t,n)$. The dominant frequency is near $0.25$ (period-4).}}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:fft}{{8}{7}{Left: signed error $e(t,n)$. Right: Raw FFT of $e(t,n)$. The dominant frequency is near $0.25$ (period-4)}{figure.caption.9}{}}
