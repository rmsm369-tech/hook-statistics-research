\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Empirical mean (solid) vs.\ Craig--Ono--Singh asymptotic (dashed) for $t=1,2,3$. Convergence is visible but oscillatory.}}{5}{figure.caption.4}\protected@file@percent }
